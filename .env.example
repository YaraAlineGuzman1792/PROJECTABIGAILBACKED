# Copia este archivo a «.env» y rellena los valores. NUNCA subas .env al repositorio.

ENTORNO=desarrollo

# Clave maestra: 64 caracteres como mínimo en producción.
#   python -c "import secrets; print(secrets.token_hex(48))"
CLAVE_MAESTRA=

# Base de datos. Con SQLite basta un archivo; para PostgreSQL pon la URL completa.
DATABASE_URL=sqlite:///./datos/abigail.db
# DATABASE_URL=postgresql+psycopg2://usuario:clave@servidor:5432/abigail

# Administración. Usa una de las dos: la contraseña en claro (la aplicación la
# convierte en hash al arrancar) o el hash ya calculado con scripts/crear_admin.py.
ADMIN_USUARIO=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Cabecera con la IP real cuando hay un proxy delante. Déjala vacía si no lo hay:
# de lo contrario cualquiera podría falsificarla y saltarse el límite de tasa.
#   Cloudflare: CF-Connecting-IP   ·   Render: X-Forwarded-For   ·   Fly: Fly-Client-IP
CABECERA_IP_CONFIABLE=

# Orígenes permitidos para CORS. El juego no es un navegador, así que lo normal
# es dejarlo vacío.
ORIGENES_PERMITIDOS=[]
